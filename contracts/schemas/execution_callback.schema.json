{
  "$defs": {
    "BusinessStatus": {
      "enum": [
        "PENDING",
        "VALIDATED",
        "APPLIED",
        "PARTIALLY_APPLIED",
        "REJECTED",
        "FAILED",
        "TIMEOUT_UNKNOWN",
        "MANUAL_REVIEW"
      ],
      "title": "BusinessStatus",
      "type": "string"
    },
    "IntegrationError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "IntegrationError",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "youjie.callback/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "source": {
      "title": "Source",
      "type": "string"
    },
    "command_id": {
      "title": "Command Id",
      "type": "string"
    },
    "correlation_id": {
      "title": "Correlation Id",
      "type": "string"
    },
    "operation_id": {
      "title": "Operation Id",
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "business_status": {
      "$ref": "#/$defs/BusinessStatus"
    },
    "scenario_hash": {
      "title": "Scenario Hash",
      "type": "string"
    },
    "plan_hash": {
      "title": "Plan Hash",
      "type": "string"
    },
    "source_revision_after": {
      "title": "Source Revision After",
      "type": "string"
    },
    "occurred_at": {
      "title": "Occurred At",
      "type": "string"
    },
    "target_record_ids": {
      "items": {
        "type": "string"
      },
      "title": "Target Record Ids",
      "type": "array"
    },
    "changed_entities": {
      "items": {
        "type": "string"
      },
      "title": "Changed Entities",
      "type": "array"
    },
    "errors": {
      "items": {
        "$ref": "#/$defs/IntegrationError"
      },
      "title": "Errors",
      "type": "array"
    },
    "evidence_hash": {
      "default": "",
      "title": "Evidence Hash",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "source",
    "command_id",
    "correlation_id",
    "operation_id",
    "sequence",
    "business_status",
    "scenario_hash",
    "plan_hash",
    "source_revision_after",
    "occurred_at"
  ],
  "title": "ExecutionCallback",
  "type": "object"
}